#Project service
COMPOSE_PROJECT_NAME=go_auth
CUREENT_CONFIG_PATH=/var/www/html/.devcontainer/.env
ENVIRONMENT=local

#Server settings
VHOST=go_auth
VHOST_PORT=8083
TIMEOUT=4s
IDDLE_TIMEOUT=60s

#DB settings
DB_IMAGE=postgres
DB_IMAGE_TAG=latest
DB_NAME=cscart
DB_USER=root
DB_PASS=root

#Adminer settings
ADMINER_IMAGE=adminer
ADMINER_IMAGE_TAG=latest
ADMINER_PORT=8082

#Other settings
GO_ARCHIVE=go1.22.5.linux-amd64.tar.gz
UID=1001
GID=1001
SSH_FILE=~/.ssh/id_rsa
SSH_CONFIG_FILE=~/.ssh/config
